STOCKPILOT_ADDR=:8080
STOCKPILOT_DATABASE_URL=postgres://stockpilot:stockpilot@localhost:5432/stockpilot?sslmode=disable
STOCKPILOT_ALLOWED_ORIGINS=http://localhost:5173
STOCKPILOT_LOG_LEVEL=info
STOCKPILOT_RATE_LIMIT_PER_MINUTE=240
# Use dev only for trusted local development. Use token in deployments.
STOCKPILOT_AUTH_MODE=dev
# Example format only; generate your own 24+ character secrets and never commit them.
STOCKPILOT_AUTH_TOKENS=replace-with-a-long-random-token:admin
VITE_API_BASE_URL=http://localhost:8080/api/v1
