APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://stockpilot:stockpilot@localhost:5432/stockpilot?sslmode=disable
DATABASE_URL_DOCKER=postgres://stockpilot:replace-with-database-password@db:5432/stockpilot?sslmode=disable
POSTGRES_PASSWORD=replace-with-database-password
SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_TTL=12h
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
BACKUP_DIR=./backups
AUTO_MIGRATE=true
MIGRATIONS_DIR=./migrations
STATIC_DIR=./web/dist
